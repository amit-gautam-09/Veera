# Copy to .env and fill in. Never commit .env.
# Priority: env vars > .env file > defaults in src/vera/config.py

# --- LLM (required for the LLM composer; without it the bot runs on deterministic fallbacks) ---
ANTHROPIC_API_KEY=
VERA_COMPOSER_MODEL=claude-sonnet-5
VERA_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
VERA_LLM_TIMEOUT_S=6
VERA_LLM_MAX_CONCURRENCY=8

# --- Latency budgets (seconds) ---
VERA_TICK_DEADLINE_S=7
VERA_REPLY_DEADLINE_S=5

# --- Persistence ---
VERA_DB_PATH=data/vera.db

# --- Metadata (/v1/metadata) ---
VERA_TEAM_NAME=Amit Gautam
VERA_TEAM_MEMBERS=Amit Gautam
VERA_CONTACT_EMAIL=
VERA_SUBMITTED_AT=

# --- Server ---
PORT=8080
LOG_LEVEL=INFO

# --- Local judge simulator wrapper (scripts/run_simulator.py) ---
BOT_URL=http://localhost:8080
JUDGE_LLM_PROVIDER=anthropic
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=claude-sonnet-5
