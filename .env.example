# Copy to .env and fill in. Never commit .env.
# Priority: env vars > .env file > defaults (docs/02-TRD.md §10)

# --- LLM (no key = deterministic mode) ---
# provider: anthropic (ANTHROPIC_API_KEY) | gemini (free tier; VERA_LLM_API_KEY) | openai_compatible (+ VERA_LLM_BASE_URL)
VERA_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
VERA_LLM_API_KEY=
VERA_LLM_BASE_URL=
VERA_LLM_ENABLED=true
# blank = provider default (anthropic: claude-sonnet-5, gemini: gemini-3.5-flash-lite)
VERA_COMPOSER_MODEL=
VERA_LLM_MAX_CONCURRENCY=10
VERA_LLM_TIMEOUT_S=6
# blank = provider default (gemini: low). Anthropic: output_config.effort; OpenAI-compatible: reasoning_effort
VERA_LLM_EFFORT=

# --- Latency budgets (seconds) ---
VERA_TICK_DEADLINE_S=7
VERA_REPLY_DEADLINE_S=5
VERA_REPAIR_MIN_REMAINING_S=3

# --- Persistence ---
VERA_DB_PATH=data/vera.db
VERA_RESTORE_WINDOW_S=7200
VERA_MAX_PAYLOAD_BYTES=512000

# --- Metadata (/v1/metadata) ---
VERA_TEAM_NAME=Amit Gautam
VERA_TEAM_MEMBERS=Amit Gautam
VERA_CONTACT_EMAIL=
VERA_SUBMITTED_AT=

# --- Server ---
PORT=8080
LOG_LEVEL=INFO

# --- Local judge simulator wrapper (scripts/run_simulator.py) ---
BOT_URL=http://127.0.0.1:8080
JUDGE_LLM_PROVIDER=anthropic
JUDGE_LLM_API_KEY=
# anthropic: claude-sonnet-5 | gemini: gemini-flash-latest
JUDGE_LLM_MODEL=
JUDGE_SCENARIO=full_evaluation
